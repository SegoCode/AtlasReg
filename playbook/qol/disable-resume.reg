Windows Registry Editor Version 5.00

; Disables the CrossDeviceResume process

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CrossDeviceResume\Configuration]
"IsResumeAllowed"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\PolicyManager\default\Connectivity\DisableCrossDeviceResume]
"Value"=dword:00000001

